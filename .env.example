# AICTE SmartFlow Environment Configuration

# Project Metadata
PROJECT_NAME="AICTE SmartFlow"
VERSION="1.0.0"

# Application Security
# Generate a secure secret using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=aicte_smartflow_hackathon_super_secret_jwt_key_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite (Out-of-the-box zero setup):
DATABASE_URL=sqlite:///./aicte_smartflow.db

# PostgreSQL (Production / National Hackathon Setup):
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/aicte_smartflow

# AI / LLM Configuration
# Optional: Live Google Gemini API key for dynamic extraction and chat
# (Leave empty to use high-precision local deterministic RAG and regex heuristic rules)
GEMINI_API_KEY=

# Notification Configuration (Optional)
SMTP_SERVER=localhost
SMTP_PORT=1025
SMTP_ENABLED=false
